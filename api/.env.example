# Copy this file to api/.env and fill in real values. Never commit api/.env.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# SMTP (PHPMailer - used by relocated lead scripts + future admin notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=noreply@ecommlab.in
SMTP_FROM_NAME="Ecomm Lab"
LEADS_TO_ADDRESS=shubham@ecommlab.in
# Optional secondary recipient, CC'd on every lead notification. Leave blank to disable.
LEADS_CC_ADDRESS=

# Google reCAPTCHA v3 (server-side secret; used by lib/recaptcha.php to
# verify contact-form submissions). Leave blank to disable verification
# (e.g. local dev without keys). Get keys at https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
# Minimum score (0.0-1.0) siteverify must return to accept a submission.
# Google recommends starting at 0.5 and tuning from real traffic.
RECAPTCHA_MIN_SCORE=0.5

# Session / CSRF
SESSION_SECRET=
APP_ENV=production
