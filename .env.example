# Copy this file to .env and adjust as needed. Used by docker-compose.yml
# for local development only - never used in production.
# Never commit the real .env.

# MySQL (db service)
DB_NAME=portfolio
DB_USER=portfolio
DB_PASS=portfolio
DB_ROOT_PASSWORD=root
DB_PORT=3306

# Session / CSRF (api service)
SESSION_SECRET=dev-only-insecure-secret

# SMTP (api service) - optional for local dev, leave blank to skip mail sending
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=noreply@ecommlab.in
SMTP_FROM_NAME="Ecomm Lab"
LEADS_TO_ADDRESS=
LEADS_CC_ADDRESS=

# Google reCAPTCHA v3 - secret + score threshold stay server-side (api
# service), site key is public and consumed by the frontend build.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Frontend (web service / `npm run dev`) - Vite exposes VITE_* vars as-is.
VITE_RECAPTCHA_SITE_KEY=

PRERENDER_API_BASE_URL=